        "font": {"name": "Calibri", "size": 12.0, "bold": True, "italic": False, "color": "00000000"},
        "fill_type": "solid",
        "fill_color": "FFF9CB9C",  # Warna Peach kustom Anda
        "border": {"top": "thin", "bottom": "double", "left": "thin", "right": "thin"},
        "alignment": {"horizontal": "center", "vertical": "center", "wrap_text": True}
    }

    print("Menerapkan format ke memori...")
    # Sekarang fungsi ini murni mewarnai & memberi border range B2:M30 tanpa mengisi value apa pun
    apply_format_to_cell(ws, "B2:M30", format_dictionary=format_sampel)

    print("Membuat Merge & Center...")
    # Menggabungkan sel B2 sampai C5, menjadikannya rata tengah, dan memberikan value teks
    merge_and_center_cells(ws, "B2:C5", new_value="JUDUL LAPORAN")

    print("Menyimpan file...")
    # Menyimpan hasil manipulasi memori ke file fisik Excel
    save_workbook(wb, FILE_OUTPUT)
