# 2. LOGIKA UTAMA PENGOLAHAN DATA PYTHON (BACKEND)
def proses_dokumen_python(nama_file, konten_file):
    """
    Di sinilah logikanya! Anda bisa memodifikasi fungsi ini untuk membaca data,
    mencari kata kunci, parsing data finansial, dll.
    Sebagai simulasi, kita akan menghitung jumlah kata dan membalikkan isi teks.
    """
    jumlah_karakter = len(konten_file)
    jumlah_kata = len(konten_file.split())
    teks_terbalik = konten_file[::-1] # Membalik string dokumen
    
    hasil_analisis = (
        f"=== LAPORAN PENGOLAHAN PYTHON ===\n"
        f"Nama File      : {nama_file}\n"
        f"Total Karakter : {jumlah_karakter}\n"
        f"Total Kata     : {jumlah_kata}\n"
        f"---------------------------------\n"
        f"Pratinjau Teks Terbalik:\n{teks_terbalik[:500]}"
    )
    return hasil_analisis

# 3. PENGATURAN SERVER WEB PYTHON BAWAAN
class CustomAppHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        """Menampilkan antarmuka GUI Chrome saat pertama dibuka."""
        self.send_response(200)
        self.send_header("Content-type", "text/html; charset=utf-8")
        self.end_headers()
        self.wfile.write(bytes(KODE_HTML, "utf-8"))

    def do_POST(self):
        """Menerima kiriman file drag-and-drop dari JavaScript Chrome."""
        if self.path == '/olah-data':
            # Mengambil panjang data yang dikirim
            content_length = int(self.headers['Content-Length'])
            post_data = self.rfile.read(content_length)
            
            # Memuat data JSON dari JavaScript
            data_masuk = json.loads(post_data.decode('utf-8'))
            nama_file = data_masuk.get('nama', 'tanpa_nama.txt')
            konten_file = data_masuk.get('konten', '')
            
            # Panggil fungsi pengolahan Python
            hasil_proses = proses_dokumen_python(nama_file, konten_file)
            
            # Mengirim kembali hasilnya ke Chrome dalam bentuk JSON
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            
            respon_json = json.dumps({"hasil": hasil_proses})
            self.wfile.write(bytes(respon_json, "utf-8"))

    def log_message(self, format, *args):
        """Biar shell IDLE tetap bersih dari log HTTP request."""
        pass

def jalankan_server():
    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer(("", PORT), CustomAppHandler) as httpd:
        print(f"\n[SERVER] Sistem siap di port {PORT}")
        httpd.serve_forever()

# --- EKSEKUSI ALUR GUI ---
if __name__ == "__main__":
    # Jalankan server lokal di background
    server_thread = threading.Thread(target=jalankan_server, daemon=True)
